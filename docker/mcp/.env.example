INGEST_TOKEN=change-me-ingest
MCP_TOKEN=change-me-mcp

EMBED_URL=http://giga-embeddings:7997/v1
EMBED_MODEL=Giga-Embeddings-instruct
EMBED_API_KEY=
# Instruct prefix is applied to search queries only, not document chunks.
# The app expands \n to a real newline.
EMBED_QUERY_PREFIX=Instruct: Given a question, retrieve passages that answer the question\nQuery: 

PORT=8004
DB_PATH=/data/help.sqlite
