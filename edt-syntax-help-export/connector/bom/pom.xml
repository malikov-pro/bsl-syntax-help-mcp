<?xml version="1.0" encoding="UTF-8"?>
<project
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.malikov-pro.dt.bsl.syntaxhelp</groupId>
  <artifactId>bom</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>BOM</name>

  <prerequisites>
    <maven>3.9.4</maven>
  </prerequisites>

  <properties>
    <!--
      Tycho 5 требуется таргету, а не вкусу: бандлы EDT 2026.2 содержат классы
      мажор-версии 69 (Java 25), и ECJ внутри Tycho 4.0.x (3.36) не умеет их
      читать. Tycho 5.0.4 несёт ECJ 3.46 и требует, чтобы Maven запускался на
      JDK 21+ — это JDK, которым ЗАПУСКАЕТСЯ сборка, а не уровень, в который
      компилируется бандл (он остаётся 17, см. tycho-compiler-plugin).
    -->
    <tycho.version>5.0.4</tycho.version>
    <tycho.extras.version>5.0.4</tycho.extras.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.release>17</maven.compiler.release>

    <maven.build.timestamp.format>'v'yyyyMMddHHmmss</maven.build.timestamp.format>
    <qualifier>${maven.build.timestamp}</qualifier>
    <forceContextQualifier>${maven.build.timestamp}</forceContextQualifier>

    <tycho.localArtifacts>ignore</tycho.localArtifacts>
    <tycho.resolver.classic>false</tycho.resolver.classic>
    <tycho.baseline.skip>true</tycho.baseline.skip>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>target-platform-configuration</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <!--
              Окружение только РЕЗОЛВА таргета: бандлы EDT 2026.2 требуют
              osgi.ee JavaSE-25, и резолв в окружении JavaSE-17 их не находит.
              Во что бандл КОМПИЛИРУЕТСЯ, задаётся отдельно и остаётся 17:
              tycho-compiler-plugin ниже держит release 17, а MANIFEST.MF —
              Bundle-RequiredExecutionEnvironment JavaSE-17, поэтому один
              артефакт ставится и на EDT 2026.1 (Eclipse 4.30 / Java 17),
              и на EDT 2026.2 (Eclipse 4.38 / Java 25).
            -->
            <executionEnvironment>JavaSE-25</executionEnvironment>
            <target>
              <artifact>
                <groupId>com.github.malikov-pro.dt.bsl.syntaxhelp</groupId>
                <artifactId>default</artifactId>
                <version>0.3.0-SNAPSHOT</version>
              </artifact>
            </target>
            <dependency-resolution>
              <extraRequirements>
                <requirement>
                  <type>eclipse-plugin</type>
                  <id>javax.annotation</id>
                  <versionRange>0.0.0</versionRange>
                </requirement>
                <requirement>
                  <type>eclipse-plugin</type>
                  <id>com._1c.g5.wiring</id>
                  <versionRange>0.0.0</versionRange>
                </requirement>
              </extraRequirements>
            </dependency-resolution>
            <environments>
              <environment>
                <os>win32</os>
                <ws>win32</ws>
                <arch>x86_64</arch>
              </environment>
              <environment>
                <os>linux</os>
                <ws>gtk</ws>
                <arch>x86_64</arch>
              </environment>
              <environment>
                <os>macosx</os>
                <ws>cocoa</ws>
                <arch>x86_64</arch>
              </environment>
            </environments>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-maven-plugin</artifactId>
          <version>${tycho.version}</version>
          <extensions>true</extensions>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-compiler-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <!--
              Уровень байткода — отдельно от окружения резолва выше: таргет
              Java 25, бандл — Java 17, поэтому один артефакт грузится и на
              EDT 2026.1 (там Java 17); release вдобавок запрещает API новее 17.
            -->
            <release>17</release>
            <encoding>UTF-8</encoding>
            <strictCompilerTarget>true</strictCompilerTarget>
            <useProjectSettings>true</useProjectSettings>
            <showWarnings>true</showWarnings>
            <showDeprecation>true</showDeprecation>
            <verbose>true</verbose>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-source-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <archive>
              <addMavenDescriptor>false</addMavenDescriptor>
            </archive>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>plugin-source</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-packaging-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <format>'v'yyyyMMddHHmmss</format>
            <forceContextQualifier>${maven.build.timestamp}</forceContextQualifier>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-p2-plugin</artifactId>
          <version>${tycho.version}</version>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-p2-repository-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <repositoryName>${project.name} Repository</repositoryName>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
